        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"seasons\" (\"tv_show_tmdb_id\" TEXT NOT NULL REFERENCES t_v_shows (tmdb_id) ON DELETE CASCADE, \"season_number\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"poster_url\" TEXT NULL, \"overview\" TEXT NULL, \"number_of_episodes\" INTEGER NULL, PRIMARY KEY (\"tv_show_tmdb_id\", \"season_number\"), CHECK (season_number >= 0));"
        }
