          "sql": "CREATE TABLE IF NOT EXISTS \"media_files\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_id\" TEXT NOT NULL REFERENCES storage_sources(source_id)ON DELETE CASCADE, \"path\" TEXT NOT NULL, \"file_name\" TEXT NOT NULL, \"parsed_title\" TEXT NOT NULL, \"parsed_year\" INTEGER, \"parsed_season\" INTEGER, \"parsed_episode\" INTEGER, \"media_type\" TEXT NOT NULL, \"explicit_tmdb_id\" TEXT, \"movie_tmdb_id\" TEXT REFERENCES movies(tmdb_id), \"tv_show_tmdb_id\" TEXT REFERENCES t_v_shows(tmdb_id), \"episode_key\" TEXT, \"metadata_match_status\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"container\" TEXT, \"width\" INTEGER, \"height\" INTEGER, \"video_codec\" TEXT, \"audio_codec\" TEXT, \"audio_channels\" TEXT, \"is_hdr\" INTEGER NOT NULL, \"hdr_format\" TEXT, \"version_label\" TEXT, \"duration\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"watch_status\" TEXT NOT NULL, \"last_watched_at\" TEXT, \"is_favorite\" INTEGER NOT NULL, \"added_at\" TEXT NOT NULL, UNIQUE(source_id, path), FOREIGN KEY(episode_key, tv_show_tmdb_id)REFERENCES episodes(episode_key, tv_show_tmdb_id), CHECK(movie_tmdb_id IS NULL OR(media_type = 'movie' AND tv_show_tmdb_id IS NULL AND episode_key IS NULL)), CHECK(tv_show_tmdb_id IS NULL OR media_type = 'episode'), CHECK(episode_key IS NULL OR tv_show_tmdb_id IS NOT NULL), CHECK(size >= 0 AND duration >= 0 AND position >= 0), CHECK(parsed_season IS NULL OR parsed_season >= 0), CHECK(parsed_episode IS NULL OR parsed_episode >= 0));"
