        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"t_v_shows\" (\"tmdb_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"original_title\" TEXT NULL, \"release_year\" INTEGER NULL, \"first_air_date\" TEXT NULL, \"poster_url\" TEXT NULL, \"backdrop_url\" TEXT NULL, \"logo_url\" TEXT NULL, \"overview\" TEXT NULL, \"certification\" TEXT NULL, \"rating\" REAL NOT NULL, \"genres\" TEXT NOT NULL, \"cast\" TEXT NOT NULL, \"status\" TEXT NULL, \"number_of_seasons\" INTEGER NULL, \"number_of_episodes\" INTEGER NULL, PRIMARY KEY (\"tmdb_id\"));"
        }
