  "fixed_sql": [
    {
      "name": "media_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media_files\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_id\" TEXT NOT NULL, \"storage_key\" TEXT NOT NULL UNIQUE, \"path\" TEXT NOT NULL, \"file_name\" TEXT NOT NULL, \"parsed_title\" TEXT NOT NULL, \"parsed_year\" INTEGER NULL, \"parsed_season\" INTEGER NULL, \"parsed_episode\" INTEGER NULL, \"media_type\" TEXT NOT NULL, \"explicit_tmdb_id\" TEXT NULL, \"movie_tmdb_id\" TEXT NULL, \"tv_show_tmdb_id\" TEXT NULL, \"episode_tmdb_id\" TEXT NULL, \"metadata_match_status\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"container\" TEXT NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"video_codec\" TEXT NULL, \"audio_codec\" TEXT NULL, \"audio_channels\" TEXT NULL, \"is_hdr\" INTEGER NOT NULL CHECK (\"is_hdr\" IN (0, 1)), \"hdr_format\" TEXT NULL, \"version_label\" TEXT NULL, \"duration\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"watch_status\" TEXT NOT NULL, \"last_watched_at\" TEXT NULL, \"is_favorite\" INTEGER NOT NULL CHECK (\"is_favorite\" IN (0, 1)), \"added_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "movies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"movies\" (\"tmdb_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"original_title\" TEXT NULL, \"release_year\" INTEGER NULL, \"release_date\" TEXT NULL, \"poster_url\" TEXT NULL, \"backdrop_url\" TEXT NULL, \"logo_url\" TEXT NULL, \"overview\" TEXT NULL, \"certification\" TEXT NULL, \"rating\" REAL NOT NULL, \"genres\" TEXT NOT NULL, \"cast\" TEXT NOT NULL, PRIMARY KEY (\"tmdb_id\"));"
        }
      ]
    },
    {
      "name": "t_v_shows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"t_v_shows\" (\"tmdb_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"original_title\" TEXT NULL, \"release_year\" INTEGER NULL, \"first_air_date\" TEXT NULL, \"poster_url\" TEXT NULL, \"backdrop_url\" TEXT NULL, \"logo_url\" TEXT NULL, \"overview\" TEXT NULL, \"certification\" TEXT NULL, \"rating\" REAL NOT NULL, \"genres\" TEXT NOT NULL, \"cast\" TEXT NOT NULL, \"status\" TEXT NULL, \"number_of_seasons\" INTEGER NULL, \"number_of_episodes\" INTEGER NULL, PRIMARY KEY (\"tmdb_id\"));"
        }
      ]
    },
    {
      "name": "seasons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"seasons\" (\"season_key\" TEXT NOT NULL, \"season_number\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"poster_url\" TEXT NULL, \"overview\" TEXT NULL, \"number_of_episodes\" INTEGER NULL, PRIMARY KEY (\"season_key\"));"
        }
      ]
    },
    {
      "name": "episodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"episodes\" (\"tmdb_id\" TEXT NOT NULL, \"episode_number\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"air_date\" TEXT NULL, \"overview\" TEXT NULL, \"still_url\" TEXT NULL, \"guest_stars\" TEXT NOT NULL, PRIMARY KEY (\"tmdb_id\"));"
        }
      ]
    },
    {
      "name": "storage_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"storage_sources\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_id\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"endpoint\" TEXT NOT NULL, \"root_path\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"username\" TEXT NOT NULL, \"password\" TEXT NOT NULL);"
        }
